      "widgets_values": [
        "#You do not need to use script input node. It however has some +es. For example faster repeated execution of workflow since transformations needed for code to run happen only once, not for each change of math node input.\n#Also you get line numbers so searching for error is easier\n# there are some input variables- V... for value input F... for float input. \n# Semicolon is used to separate commands. This line inverts image we sent to V0 since F0 = 1.\nt = F0-V0;\n# last expression determines output of the node. It does not have to be just variable as here. Ve could just put the F0-V0 as the only line\nt\n\n# If you see ValueError: Syntax error in expression at line 6, col 0: no viable alternative at input 't=F0-V0t' or something simillar, you forgot a semicolon"
      ],
      "widgets_values_named": {
        "script": "#You do not need to use script input node. It however has some +es. For example faster repeated execution of workflow since transformations needed for code to run happen only once, not for each change of math node input.\n#Also you get line numbers so searching for error is easier\n# there are some input variables- V... for value input F... for float input. \n# Semicolon is used to separate commands. This line inverts image we sent to V0 since F0 = 1.\nt = F0-V0;\n# last expression determines output of the node. It does not have to be just variable as here. Ve could just put the F0-V0 as the only line\nt\n\n# If you see ValueError: Syntax error in expression at line 6, col 0: no viable alternative at input 't=F0-V0t' or something simillar, you forgot a semicolon"
      }
